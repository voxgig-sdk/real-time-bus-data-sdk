# BasicEtaFlow

main: kit: flow: BasicEtaFlow:
{
  entity: "eta",
  kind: "basic",
  name: "BasicEtaFlow",
  step: [
    {
      match: {
        route: "route01",
        service_type: "service_type01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "eta_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "eta_ref01",
        srcdatavar: "eta_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "eta01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-eta_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEtaFlow"
}
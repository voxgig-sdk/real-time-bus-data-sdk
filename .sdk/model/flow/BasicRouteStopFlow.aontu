# BasicRouteStopFlow

main: kit: flow: BasicRouteStopFlow:
{
  entity: "route_stop",
  kind: "basic",
  name: "BasicRouteStopFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "route_stop_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "route_stop_ref01",
        srcdatavar: "route_stop_ref01_data",
        suffix: "_dt0"
      }

      match: {
        direction: "direction01",
        id: "route_stop01",
        route: "route01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-route_stop_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRouteStopFlow"
}